<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.mosaikit</groupId>
        <artifactId>mosaikit-plugin-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath/>
    </parent>
    <groupId>io.github.mosaikit.samples</groupId>
    <artifactId>sample-notes</artifactId>
    <version>0.1.0</version>
    <name>Notes (sample)</name>
    <description>Java code: an entity, a migration, a REST API, an app and actions for assistants.</description>
    <!--
      Java code compiles against the plugin API, the Jakarta APIs and the Quarkus extensions that the
      kernel already contains, all with scope "provided": the kernel supplies them at runtime and the
      JAR in lib/ holds only the classes of the plugin.
    -->
    <dependencies>
        <dependency>
            <groupId>io.github.mosaikit</groupId>
            <artifactId>mosaikit-kernel-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.data</groupId>
            <artifactId>jakarta.data-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
