{
  "name": "sample-vue",
  "version": "0.1.0",
  "private": true,
  "description": "An extension written with Vue: a swatch in palette.preview that follows the selection of the React app.",
  "license": "MPL-2.0",
  "author": "Massimo Antonini",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "dev": "mosaikit-bench",
    "pretest": "playwright install chromium",
    "test": "playwright test",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mosaikit/sdk": "https://github.com/mosaikit/mosaikit/releases/download/snapshot/mosaikit-sdk-latest.tgz",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@mosaikit/testing": "https://github.com/mosaikit/mosaikit/releases/download/snapshot/mosaikit-testing-latest.tgz",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64": true,
    "@embedded-postgres/linux-x64": true,
    "@embedded-postgres/linux-arm64": true,
    "@embedded-postgres/darwin-x64": true,
    "@embedded-postgres/darwin-arm64": true
  }
}
